NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Redis
REDIS_URL=redis://redis:6379

# Providers
OPENAI_API_KEY=REPLACE_WITH_YOUR_KEY
ANTHROPIC_API_KEY=REPLACE_WITH_YOUR_KEY
GEMINI_API_KEY=REPLACE_WITH_YOUR_KEY
OLLAMA_HOST=http://ollama:11434

# AI Model Preferences
AI_MODEL_PREFERENCE=flash  # 'pro' or 'flash'

# Content Service
CONTENT_BASE_URL=http://content-service:3000
CONTENT_API_KEY=REPLACE_WITH_YOUR_KEY

# Events
EVENT_SYSTEM=redis
EVENT_REDIS_URL=redis://redis:6379

# Policies
AI_POLICIES_DIR=/app/policies
AI_POLICIES_RELOAD_INTERVAL=60000

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
METRICS_PORT=9090

# Security
API_KEY_HEADER=X-API-Key
ALLOWED_SERVICES=finance,trading,content

# Feature Flags
ENABLE_INTELLIGENT_ROUTING=false
ENABLE_DECISION_RESPONSES=false
ENABLE_HYBRID_INTENT_CLASSIFIER=true  # Default: true (80% keywords, 15% regex, 5% LLM)